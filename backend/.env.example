# ── Entorno ───────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV=production

# ── Servidor ──────────────────────────────────────────────
PORT=3000

# ── Base de datos MySQL ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=workly_db

# Tamaño del pool de conexiones (opcional, default: 10)
DB_CONNECTION_LIMIT=10

# ── JWT ───────────────────────────────────────────────────
# IMPORTANTE: usa strings largos y aleatorios en producción
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_string_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=otro_string_diferente_igual_de_largo_y_secreto

# Expiración del access token (30m recomendado)
JWT_EXPIRES_IN=30m

# Expiración del refresh token (7d recomendado)
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
# URL del frontend (sin barra final)
FRONTEND_URL=http://localhost:5173
# En producción: FRONTEND_URL=https://tudominio.com

# ── VeriFactu (modo VERI*FACTU, implementación propia) ────
# noop no envía nada y no pinta el QR. aeat genera la huella, el XML, el QR
# y encola el envío SOAP. El valor por defecto es noop para no enviar nada
# hasta que el titular configure productor y certificado.
VERIFACTU_PROVIDER=noop
# test (preproducción) o production. Si no se indica, se usa test.
VERIFACTU_ENV=test
# personal (certificado de persona física o representante) o sello (de entidad).
VERIFACTU_CERT_KIND=personal
# Datos del productor del sistema informático. El NIF tiene 9 caracteres.
# IdSistemaInformatico tiene 1 o 2 caracteres y debe coincidir con la declaración responsable.
VERIFACTU_PRODUCER_NAME=
VERIFACTU_PRODUCER_NIF=
VERIFACTU_SYSTEM_ID=01
VERIFACTU_SYSTEM_NAME=Workly
VERIFACTU_SYSTEM_VERSION=1.0.0
# 32 bytes en base64. Cifra los PFX de los clientes. No es un certificado.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VERIFACTU_CERT_KEY=
# Certificado de la plataforma, solo si algún cliente usa apoderamiento.
# No lo subas al repositorio. Vale la ruta o el PFX en base64.
VERIFACTU_PLATFORM_PFX_PATH=
VERIFACTU_PLATFORM_PFX_BASE64=
VERIFACTU_PLATFORM_PFX_PASSPHRASE=
# 0 apaga el worker. El intervalo por defecto es 30 segundos.
VERIFACTU_WORKER_MS=30000

# ── Email (Resend) ────────────────────────────────────────
# Necesario para envío de facturas por email
# Obtener en: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Workly <noreply@tudominio.com>

# ── Registro y avisos de error ────────────────────────────
# pretty en desarrollo, json en producción si no se indica.
LOG_FORMAT=pretty
# Opcional. Si tiene valor, cada error 500 hace un POST con el mensaje (sin pila).
ERROR_WEBHOOK_URL=

# ── Copias de MySQL (scripts/backup-mysql.sh) ─────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ── Rate limiting ─────────────────────────────────────────
# Peticiones máximas por IP en 15 minutos (ventana general)
RATE_LIMIT_MAX=500
# Intentos de auth máximos por IP en 15 minutos
RATE_LIMIT_AUTH_MAX=20

# ── Stripe (billing y planes de suscripción) ──────────────
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Secret del webhook (Dashboard Stripe → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# IDs de precios de Stripe (Dashboard → Productos → Precio → copiar price_...)
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxxxxxxxxxxxxxxxxxxx

OPENAI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxx